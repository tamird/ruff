load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files([
    "cargo-bazel.json",
    "cargo_metadata.bzl",
    "datatest-stable-file-symlinks.patch",
    "mdtest_external.sh",
    "rust_crate.bzl",
    "workspace_metadata.bzl",
])

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@zig_sdk//libc:gnu.2.17",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "remote_linux_amd64",
    exec_properties = {
        "Arch": "amd64",
        "OSFamily": "linux",
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu24-04@sha256:be9853fc45092d2cf2bda3abed30d22182881659a50bf35c7125161d7cfc8a75",
    },
    parents = [":linux_amd64"],
    visibility = ["//visibility:public"],
)

# Export the canonical generator outputs from a remote frontend for review.
genrule(
    name = "dependency_metadata",
    srcs = [
        "cargo-bazel.json",
        "//:MODULE.bazel.lock",
        "@crates//:defs.bzl",
    ],
    outs = ["resolved-cargo-bazel.json", "resolved-MODULE.bazel.lock"],
    cmd = "cp $(location cargo-bazel.json) $(location resolved-cargo-bazel.json) && cp $(location //:MODULE.bazel.lock) $(location resolved-MODULE.bazel.lock)",
)

genrule(
    name = "metadata_snapshot",
    srcs = ["metadata_snapshot.sh", "@crates//:defs.bzl"],
    outs = ["run_metadata_snapshot.sh"],
    cmd = "cp $(location metadata_snapshot.sh) $@ && chmod +x $@",
    executable = True,
)


sh_test(
    name = "datatest_file_links",
    srcs = ["datatest_file_links.sh"],
    args = [
        "$(rootpath //crates/ty_python_semantic:mdtest)",
        "$(rootpath test_data/datatest_symlink.md)",
    ],
    data = ["//crates/ty_python_semantic:mdtest", "test_data/datatest_symlink.md"],
    env = {"INSTA_UPDATE": "no", "INSTA_WORKSPACE_ROOT": ".", "MDTEST_EXTERNAL": "0"},
    exec_properties = {"test.EstimatedComputeUnits": "2", "test.EstimatedMemory": "2GB"},
    target_compatible_with = ["@platforms//os:linux"],
    timeout = "short",
)

# This runs uncached on the Remote Bazel frontend and may install hook tools.
sh_binary(
    name = "qualification_hooks",
    srcs = ["qualification_hooks.sh"],
    args = [
        "$(rlocationpath @uv_linux_amd64//:uv)",
        "$(rlocationpath @rules_rust//tools/upstream_wrapper:rustfmt)",
    ],
    data = [
        "@uv_linux_amd64//:uv",
        "@rules_rust//tools/upstream_wrapper:rustfmt",
    ],
    tags = ["manual", "requires-network"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)
